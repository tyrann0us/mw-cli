<?xml version="1.0"?>
<ruleset>
	<rule ref="./vendor/mediawiki/mediawiki-codesniffer/MediaWiki">
		<!-- Commands take ( $args, $assoc_args ). -->
		<exclude name="MediaWiki.NamingConventions.LowerCamelFunctionsName" />
		<exclude name="MediaWiki.Commenting.FunctionComment.MissingDocumentationPublic" />
		<exclude name="MediaWiki.Commenting.MissingCovers" />
		<!-- MediaWiki's Shell class isn't loaded yet when these run. -->
		<exclude name="MediaWiki.Usage.ForbiddenFunctions" />
	</rule>
	<rule ref="MediaWiki.Commenting.FunctionAnnotations.UnrecognizedAnnotation">
		<!-- Behat step annotations. -->
		<exclude-pattern>features/</exclude-pattern>
	</rule>
	<file>bin/mw</file>
	<file>src</file>
	<file>tests</file>
	<file>features</file>
	<arg name="extensions" value="php" />
	<arg name="encoding" value="UTF-8" />
</ruleset>
