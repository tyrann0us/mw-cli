<?xml version="1.0"?>
<ruleset>
  <!-- Use colors, and show sniff error codes and progress. -->
  <arg name="colors"/>
  <arg value="sp"/>
  <!-- Recommended Syde PHP Coding Standard rules. -->
  <rule ref="Syde-Extra">
    <!--
    mw is a CLI tool that runs inside MediaWiki, not WordPress. These sniffs
    point to WordPress APIs (WP_Filesystem, esc_html(), wp_unslash()) that don't
    exist here, and output goes to a terminal, not a browser.
    -->
    <exclude name="WordPress.WP.AlternativeFunctions"/>
    <exclude name="WordPress.Security.EscapeOutput"/>
    <exclude name="WordPress.PHP.DiscouragedPHPFunctions"/>
    <exclude name="WordPress.PHP.DevelopmentFunctions"/>
    <exclude name="WordPress.Security.ValidatedSanitizedInput"/>
  </rule>
  <!--
  bootstrap.php replaces maintenance/run.php: it has to run at file scope, and MediaWiki
  expects the MEDIAWIKI and MW_FINAL_SETUP_CALLBACK constants to be defined there.
  -->
  <rule ref="PSR1.Files.SideEffects">
    <exclude-pattern>src/bootstrap\.php$</exclude-pattern>
  </rule>
  <!-- PSR-4 namespace configuration. -->
  <rule ref="SlevomatCodingStandard.Files.TypeNameMatchesFileName">
    <properties>
      <property name="rootNamespaces" type="array">
        <element key="src" value="MwCli"/>
        <element key="tests/unit" value="MwCli\Tests"/>
        <element key="features/bootstrap" value="MwCli\Tests\Behat"/>
      </property>
    </properties>
  </rule>
  <exclude-pattern>*/vendor/*</exclude-pattern>
  <config name="testVersion" value="8.1-"/>
  <file>./bin/mw</file>
  <file>./src</file>
  <file>./tests</file>
  <file>./features</file>
  <arg name="extensions" value="php"/>
</ruleset>
