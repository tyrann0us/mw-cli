# Shared by phpstan.neon.dist (MediaWiki 1.43) and phpstan-mw146.neon.dist (MediaWiki 1.46).
parameters:
  level: 8
  paths:
    - bin/mw
    - src/
  treatPhpDocTypesAsCertain: false
  # Semantic MediaWiki source for `mw ask`, installed as a dev dependency for analysis only.
  scanDirectories:
    - vendor/mediawiki/semantic-media-wiki-src/src
