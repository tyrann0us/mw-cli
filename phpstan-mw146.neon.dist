# Catches MediaWiki APIs removed after 1.43 (e.g. MainConfigNames::BaseDirectory in 1.46).
includes:
  - phpstan-base.neon
parameters:
  # Own cache, so running both configs doesn't invalidate the other's.
  resultCachePath: %tmpDir%/resultCache-mw146.php
  scanDirectories:
    - vendor/mediawiki/core-1.46/includes
    - vendor/mediawiki/core-1.46/maintenance/includes
  scanFiles:
    - tests/phpstan/aliases-mw146.stub
